<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX v3 installer template for Recorde.
  cargo-wix injects $(var.Version) from Cargo.toml.
  Binary is always at target\release\ (cargo build --release, no --target flag).
  UpgradeCode must never change between versions.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

  <Product Id='*'
           Name='Recorde'
           UpgradeCode='F8B2C4E6-A3D5-4F7E-9B2C-6E8A1C3F5B7D'
           Language='1033'
           Codepage='1252'
           Version='$(var.Version)'
           Manufacturer='Antony Doyle'>

    <Package Id='*'
             Keywords='Installer'
             Description='Recorde git client'
             Manufacturer='Antony Doyle'
             InstallerVersion='450'
             Languages='1033'
             Compressed='yes'
             InstallScope='perMachine'
             SummaryCodepage='1252'
             Platform='x64'/>

    <MajorUpgrade
      Schedule='afterInstallInitialize'
      DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

    <Icon Id='RecordeIcon.ico' SourceFile='assets\icon.ico'/>
    <Property Id='ARPPRODUCTICON' Value='RecordeIcon.ico'/>

    <Media Id='1' Cabinet='main.cab' EmbedCab='yes'/>

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONFOLDER' Name='Recorde'>

          <Component Id='binary0' Guid='*'>
            <File Id='exe0'
                  Name='recorde.exe'
                  DiskId='1'
                  Source='target\release\recorde.exe'
                  KeyPath='yes'/>
          </Component>

          <Component Id='License' Guid='*'>
            <File Id='LicenseFile'
                  Name='LICENSE'
                  DiskId='1'
                  Source='LICENSE'
                  KeyPath='yes'/>
          </Component>

        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ApplicationProgramsFolder' Name='Recorde'/>
      </Directory>
    </Directory>

    <DirectoryRef Id='ApplicationProgramsFolder'>
      <Component Id='ApplicationShortcut' Guid='*'>
        <Shortcut Id='StartMenuShortcut'
                  Name='Recorde'
                  Description='Git client'
                  Target='[APPLICATIONFOLDER]recorde.exe'
                  WorkingDirectory='APPLICATIONFOLDER'
                  Icon='RecordeIcon.ico'/>
        <RemoveFolder Id='CleanUpShortCut'
                      Directory='ApplicationProgramsFolder'
                      On='uninstall'/>
        <RegistryValue Root='HKCU'
                       Key='Software\Recorde'
                       Name='installed'
                       Type='integer'
                       Value='1'
                       KeyPath='yes'/>
      </Component>
    </DirectoryRef>

    <Feature Id='Binaries'
             Title='Recorde'
             Description='Installs the Recorde binary and licence.'
             Level='1'
             ConfigurableDirectory='APPLICATIONFOLDER'
             AllowAdvertise='no'
             Display='expand'
             Absent='disallow'>
      <ComponentRef Id='binary0'/>
      <ComponentRef Id='License'/>
    </Feature>

    <Feature Id='Shortcuts'
             Title='Start Menu shortcut'
             Description='Adds a shortcut to the Start Menu.'
             Level='1'
             Absent='allow'>
      <ComponentRef Id='ApplicationShortcut'/>
    </Feature>

  </Product>

</Wix>
