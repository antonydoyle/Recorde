<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Recorde</vendor>
  <vendor_url>https://github.com/antonydoyle/Recorde</vendor_url>
  <action id="org.recorde.update.install">
    <description>Install an authenticated Recorde update</description>
    <message>Administrator authentication is required to install the signed Recorde update.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/recorde/recorde-update-installer</annotate>
  </action>
</policyconfig>
